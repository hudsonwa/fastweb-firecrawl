# Copy to .env and fill in. .env is git-ignored; never commit it.

# Required: SearXNG's secret key. Generate one with: openssl rand -hex 32
SEARXNG_SECRET=

# Host port for fastweb-firecrawl (always bound to 127.0.0.1).
FASTWEB_PORT=3002

# Optional Firecrawl fallback. Uncomment and fill in, then `docker compose --profile firecrawl up -d`.
# The profile refuses to start while either secret is empty; generate each with: openssl rand -hex 24
# FIRECRAWL_UPSTREAM=http://api:3002
# FIRECRAWL_POSTGRES_PASSWORD=
# FIRECRAWL_BULL_AUTH_KEY=

# Search
# SEARXNG_ENGINES=yahoo
# FASTWEB_SEARCH_FALLBACK_ENGINES=privacywall,brave
# FASTWEB_SEARCH_RELEVANCE=1

# Browser tier (0 disables it; thin/blocked pages then go to Firecrawl if configured, else fail honestly)
# FASTWEB_BROWSER=1
# FASTWEB_BROWSER_TABS=2

# Prefetch-on-search (0 disables)
# FASTWEB_PREFETCH_N=5
